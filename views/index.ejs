<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>static fields</title>
</head>
<body>
    <form action="/register" method="POST">
        <input type="/text"name="ln" placeholder="Enter Your Lastname: " required>
        <br>
        <input type="/text"name="fn" placeholder="Enter Your Firstname: " required>
        <br>
        <input type="/text"name="age" placeholder="Enter Your Age: " required>
        <br>
        <input type="/text"name="add" placeholder="Enter Your Address: " required>
        <br>
        <button type="submit">register</button>

    </form>
</body>
</html>